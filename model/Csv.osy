// CSV in and out.
//
// ⚑ WRITTEN FOR THE SPREADSHEET A SHOP OWNER ACTUALLY OPENS IT IN. Three things decide whether a file "just opens":
//   · a UTF-8 byte-order mark — without it Excel reads UTF-8 as the local code page, and "Göteborg" arrives as
//     "GÃ¶teborg";
//   · CRLF line ends and every field quoted when it holds a separator, a quote or a line break (RFC 4180);
//   · the SEPARATOR a program saves with is the locale's: a Swedish or German Excel saves `;`, because `,` is their
//     decimal point. So reading DETECTS it from the header line instead of assuming a comma.
//
// ⚑ AND A CELL CANNOT BECOME A FORMULA. A value that starts with `=`, `+`, `-` or `@` is run by the spreadsheet when the
//   file is opened (CSV injection: `=HYPERLINK(…)` in a customer's name). Written cells like that get a leading `'`,
//   which every spreadsheet shows as text; reading takes it off again, so a file round-trips. A NUMBER is left alone —
//   `-5` is a number, not a formula.

namespace Osysharp.Csv;

/// A CSV file as read: its header and its rows, each field a string exactly as the file held it (unquoted).
public class CsvTable {
  /// The first line's fields — the column names.
  public List<string> Header = [];
  /// Every line after the header, in order. Blank lines — and rows whose every field is empty — are skipped.
  public List<CsvRow> Rows = [];
  /// The separator the file uses: ",", ";" or a tab.
  public string Separator = ",";

  /// Which column `name` is (case and surrounding spaces ignored), or -1.
  public int Column(string name) {
    var wanted = name.Trim().ToLower();
    for (var i = 0; i < Header.Count; i++) {
      if (Header[i].Trim().ToLower() == wanted) { return i; }
    }
    return -1;
  }

  /// `row`'s value in column `name`, trimmed — "" when the file has no such column or the row stops short of it.
  public string Get(CsvRow row, string name) {
    var i = Column(name);
    if (i < 0 || i >= row.Fields.Count) { return ""; }
    return row.Fields[i].Trim();
  }
}

/// One line of a CSV file.
public class CsvRow {
  /// Its line number in the file (the header is line 1) — what an import names when it refuses a row.
  public int Line = 0;
  public List<string> Fields = [];
}

/// Reads CSV text. The separator is detected from the header line (`,` `;` or tab — whichever occurs most outside
/// quotes); quoted fields may hold separators, doubled quotes and line breaks; a byte-order mark is dropped, CRLF and LF
/// both end a line, and a cell written formula-safe (`'=…`) comes back as written.
/// need: import records from a CSV, read the rows of a spreadsheet someone uploaded
public CsvTable ReadCsv(string text) {
  var table = new CsvTable();
  var body = text.StartsWith("﻿") ? text.Substring(1) : text;
  table.Separator = DetectSeparator(body);
  List<string> fields = [];
  var field = "";
  var quoted = false;
  var atFieldStart = true;
  var line = 1;
  var rowLine = 1;
  var first = true;
  var i = 0;
  var n = body.Length;
  while (i <= n) {
    var c = i < n ? body.Substring(i, 1) : "\n";
    if (quoted) {
      if (c == "\"") {
        if (i + 1 < n && body.Substring(i + 1, 1) == "\"") { field = field + "\""; i = i + 2; continue; }
        quoted = false;
        i = i + 1;
        continue;
      }
      if (c == "\n") { line = line + 1; }
      field = field + c;
      i = i + 1;
      continue;
    }
    if (c == "\"" && atFieldStart) { quoted = true; atFieldStart = false; i = i + 1; continue; }
    if (c == table.Separator) {
      fields.Add(Unguard(field));
      field = "";
      atFieldStart = true;
      i = i + 1;
      continue;
    }
    if (c == "\r") { i = i + 1; continue; }
    if (c == "\n") {
      fields.Add(Unguard(field));
      // A row with every field empty is blank too — spreadsheets save the rows under a table as `,,,,`.
      var blank = fields.All(f => f.Trim() == "");
      if (!blank) {
        if (first) { table.Header = fields; first = false; }
        else { table.Rows.Add(new CsvRow { Line = rowLine, Fields = fields }); }
      }
      fields = [];
      field = "";
      atFieldStart = true;
      line = line + 1;
      rowLine = line;
      i = i + 1;
      continue;
    }
    field = field + c;
    atFieldStart = false;
    i = i + 1;
  }
  return table;
}

/// Writes a header and rows as CSV a spreadsheet opens as it is: a byte-order mark, CRLF line ends, a field quoted
/// only when it must be, and a value that would run as a formula written as text.
/// need: export a list as CSV, download a spreadsheet of rows
public string WriteCsv(List<string> header, List<List<string>> rows, string separator = ",") {
  var text = "﻿" + CsvLine(header, separator);
  foreach (var row in rows) { text = text + CsvLine(row, separator); }
  return text;
}

/// One CSV line, with its CRLF.
public string CsvLine(List<string> fields, string separator = ",") {
  return string.Join(separator, fields.Select(f => CsvField(f, separator)).ToList()) + "\r\n";
}

/// One field: formula-safe, and quoted when it holds the separator, a quote or a line break.
public string CsvField(string value, string separator = ",") {
  var v = Guard(value);
  if (v.Contains(separator) || v.Contains("\"") || v.Contains("\n") || v.Contains("\r")) {
    return "\"" + v.Replace("\"", "\"\"") + "\"";
  }
  return v;
}

/// `'` before a value a spreadsheet would run — `=`, `+`, `-`, `@` first — unless the value is a number.
string Guard(string value) {
  if (value == "") { return value; }
  var head = value.Substring(0, 1);
  if (head != "=" && head != "+" && head != "-" && head != "@") { return value; }
  decimal number;
  if (decimal.TryParse(value, out number)) { return value; }
  return "'" + value;
}

/// The reverse of `Guard`: a `'` the writer put before `= + - @` comes off.
string Unguard(string value) {
  if (value.Length < 2 || value.Substring(0, 1) != "'") { return value; }
  var next = value.Substring(1, 1);
  return next == "=" || next == "+" || next == "-" || next == "@" ? value.Substring(1) : value;
}

/// The separator the header line uses: `,` `;` or a tab, whichever occurs most outside quotes — a comma when none do.
string DetectSeparator(string text) {
  var commas = 0;
  var semicolons = 0;
  var tabs = 0;
  var quoted = false;
  for (var i = 0; i < text.Length; i++) {
    var c = text.Substring(i, 1);
    if (c == "\"") { quoted = !quoted; continue; }
    if (quoted) { continue; }
    if (c == "\n") { break; }
    if (c == ",") { commas = commas + 1; }
    else if (c == ";") { semicolons = semicolons + 1; }
    else if (c == "\t") { tabs = tabs + 1; }
  }
  if (semicolons > commas && semicolons >= tabs) { return ";"; }
  if (tabs > commas && tabs > semicolons) { return "\t"; }
  return ",";
}
